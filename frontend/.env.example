# Frontend Client Environment Variables (safe for browser exposure)
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or expose private/service-role keys.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Public Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ImageKit Public Configuration (optional until media uploads are enabled)
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key

# ---------------------------------------------------------------------------
# Server-Only Environment Variables (NEVER prefix with NEXT_PUBLIC_)
# Required in Vercel Environment Variables for admin workflows & media signing.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
